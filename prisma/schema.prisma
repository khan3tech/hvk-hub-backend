// TeamLoom data model — see specs/001..027 and .specify/memory/constitution.md
// (Principle VI: every core table carries orgId from day one, single org for v0.1)
//
// This file covers all three roadmap tranches:
//   v0.1  (001-005): Auth/RBAC, Employee Mgmt, Attendance & Leave, Payroll, Recruitment/ATS
//   v1.1  (006-015): Notifications ... Multi-Tenant Activation
//   v1.2  (016-027): Org Chart ... HR Assistant Chatbot
// New sections are grouped and commented by spec number. See docs/feature.md for the
// full per-feature Inputs/Outputs/Dependencies summary this schema implements.
//
// NOTE ON MULTI-TENANCY (015): orgId stays a plain scalar String on every model (matching
// Constitution Principle VI's original wording), NOT a Prisma relation to Organization — this
// keeps the v0.1-v1.2 models unchanged when 015 activates. See "Organization" below.
//
// SCHEMA-LEVEL GAP (flagged, not resolved here — see docs/feature.md § 009, § 002):
// Employee.email and Employee.employeeCode are now scoped @@unique([orgId, ...]) instead of
// globally unique (a correctness fix for 015 multi-tenancy). This does NOT resolve the
// 009 "rehire = new employee record" assumption colliding with a former (offboarded)
// employee's still-present email/code in the same org — that conflict needs a product decision
// (reactivate the old record vs. relax uniqueness to exclude OFFBOARDED rows) before 009 is
// implemented for a company with real rehires. TODO: resolve during 009's /speckit-plan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// v0.1 — Enums (001-005)
// ============================================================================

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  OFFBOARDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  ON_LEAVE
  HOLIDAY
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JobPostingStatus {
  OPEN
  ON_HOLD
  CLOSED
}

enum ApplicationStage {
  APPLIED
  SCREEN
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewResult {
  PENDING
  PASS
  FAIL
}

// ============================================================================
// v0.1 — Models (001-005)
// ============================================================================

model User {
  id           String    @id @default(cuid())
  orgId        String
  email        String
  passwordHash String
  role         Role
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])

  // 001-auth-rbac — account lockout (FR-011/FR-012): lockedAt doubles as both the lock
  // flag and its timestamp; no automatic unlock, only a manual Admin/HR action resets it.
  failedLoginAttempts Int            @default(0)
  lockedAt            DateTime?
  refreshTokens       RefreshToken[]

  // 013-sso-mfa
  isBreakGlass     Boolean           @default(false)
  ssoIdentityLinks SsoIdentityLink[]
  mfaEnrollment    MfaEnrollment?

  // 006-notifications, 019-mobile-pwa
  notifications       Notification[]
  deviceRegistrations DeviceRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, email])
  @@index([orgId])
}

// 001-auth-rbac — backs the hybrid session model (research.md R1): the access JWT stays
// stateless (15m), but the refresh token is a stored, revocable row so sign-out (FR-003),
// offboarding (FR-010), and lockout all take effect immediately instead of waiting for
// natural JWT expiry. Rows are never deleted, only marked revokedAt (Principle IV, append-only).
model RefreshToken {
  id        String    @id @default(cuid())
  orgId     String
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  // 019 FR-009: an installed-app instance's own session (null = a web sign-in, 001 FR-013 rules)
  deviceId  String?

  @@index([userId])
  @@index([tokenHash])
}

model Employee {
  id            String         @id @default(cuid())
  orgId         String
  employeeCode  String
  name          String
  email         String
  departmentId  String?
  department    Department?    @relation(fields: [departmentId], references: [id])
  designationId String?
  designation   Designation?   @relation(fields: [designationId], references: [id])
  managerId     String?
  manager       Employee?      @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports Employee[]     @relation("EmployeeManager")
  dateOfJoining DateTime
  status        EmployeeStatus @default(ACTIVE)

  // 026-global-multi-currency-payroll: effective-dated country/currency (FR-001, US1.3)
  payrollAssignments PayrollAssignment[]

  user              User?
  attendanceRecords Attendance[]
  leaveRequests     LeaveRequest[]    @relation("LeaveRequester")
  approvedLeaves    LeaveRequest[]    @relation("LeaveApprover")
  leaveBalances     LeaveBalance[]
  salaryStructures  SalaryStructure[]
  payslips          Payslip[]
  interviewRounds   InterviewRound[]
  activityLogs      ActivityLog[]

  // 007-employee-onboarding
  onboardingChecklist      OnboardingChecklist?
  onboardingTasksCompleted OnboardingTask[]

  // 008-document-esignature
  documents                 Document[]
  signatureRequestsReceived SignatureRequest[]
  policyAcknowledgments     PolicyAcknowledgment[]

  // 009-resignation-exit
  resignations       Resignation[]
  exitTasksCompleted ExitTask[]

  // 010-statutory-payroll-tax
  statutoryExemptions StatutoryExemption[]

  // 012-performance-management
  goals            Goal[]
  reviews          Review[] @relation("ReviewEmployee")
  reviewsAsManager Review[] @relation("ReviewManager")

  // 014-asset-expense-management
  assetAssignments      AssetAssignment[]
  expenseClaims         ExpenseClaim[]    @relation("ExpenseClaimant")
  expenseClaimsApproved ExpenseClaim[]    @relation("ExpenseApprover")

  // 017-hr-helpdesk-ticketing
  ticketsRaised   Ticket[]      @relation("TicketRequester")
  ticketsAssigned Ticket[]      @relation("TicketAssignee")
  ticketReplies   TicketReply[]

  // 021-referral-program
  referralsMade        Referral[]
  referredApplications Application[]

  // 022-background-verification
  hireOverrides HireOverride[]

  // 023-learning-development
  courseAssignments CourseAssignment[]

  // 024-succession-planning
  successionPlanAsPosition SuccessionPlan?
  successionCandidacies    SuccessionCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, email])
  @@unique([orgId, employeeCode])
  @@index([orgId])
  @@index([managerId])
  @@index([departmentId])
}

model Department {
  id             String       @id @default(cuid())
  orgId          String
  name           String
  headEmployeeId String?
  employees      Employee[]
  jobPostings    JobPosting[]

  // 018-employee-engagement-surveys, 012-performance-management
  surveys      Survey[]
  reviewCycles ReviewCycle[]

  @@unique([orgId, name])
}

model Designation {
  id        String     @id @default(cuid())
  orgId     String
  title     String
  level     Int?
  employees Employee[]

  @@unique([orgId, title])
}

model Attendance {
  id            String              @id @default(cuid())
  orgId         String
  employeeId    String
  employee      Employee            @relation(fields: [employeeId], references: [id])
  date          DateTime            @db.Date
  checkIn       DateTime?
  checkOut      DateTime?
  status        AttendanceStatus    @default(PRESENT)
  // Multiple check-in/out sessions per day: checkIn = first check-in, checkOut = last check-out
  // (null while a session is open), workedMinutes = sum of closed sessions.
  workedMinutes Int                 @default(0)
  breakMinutes  Int                 @default(0)
  sessions      AttendanceSession[]

  @@unique([employeeId, date])
  @@index([orgId, date])
}

enum AttendanceSessionKind {
  WORK
  BREAK
}

// A stretch of the day: WORK (checked in) or BREAK (on a break while checked in). At most one is
// open (checkOut null) per employee. One left open at the end of the org-local day is closed
// automatically at 23:59:59 (autoClosed) so the next day starts fresh.
model AttendanceSession {
  id           String                @id @default(cuid())
  orgId        String
  employeeId   String
  attendanceId String
  attendance   Attendance            @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  kind         AttendanceSessionKind @default(WORK)
  checkIn      DateTime
  checkOut     DateTime?
  autoClosed   Boolean               @default(false)

  @@index([attendanceId])
  @@index([employeeId, checkOut])
}

model LeaveType {
  id            String         @id @default(cuid())
  orgId         String
  name          String
  isPaid        Boolean        @default(true)
  defaultDays   Int
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  @@unique([orgId, name])
}

model LeaveBalance {
  id          String    @id @default(cuid())
  orgId       String
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  allocated   Float
  used        Float     @default(0)

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id              String             @id @default(cuid())
  orgId           String
  employeeId      String
  employee        Employee           @relation("LeaveRequester", fields: [employeeId], references: [id])
  leaveTypeId     String
  leaveType       LeaveType          @relation(fields: [leaveTypeId], references: [id])
  startDate       DateTime           @db.Date
  endDate         DateTime           @db.Date
  days            Float
  status          LeaveRequestStatus @default(PENDING)
  approverId      String?
  approver        Employee?          @relation("LeaveApprover", fields: [approverId], references: [id])
  rejectionReason String?
  createdAt       DateTime           @default(now())
  decidedAt       DateTime?

  @@index([orgId, status])
}

model Holiday {
  id     String   @id @default(cuid())
  orgId  String
  name   String
  date   DateTime @db.Date
  region String?

  @@index([orgId, date])
}

model SalaryStructure {
  id            String   @id @default(cuid())
  orgId         String
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  basic         Float
  hra           Float
  allowances    Json
  effectiveFrom DateTime @db.Date

  // 026-global-multi-currency-payroll — null = org's single default currency
  currency String?

  @@index([employeeId, effectiveFrom])
}

model Payslip {
  id                  String   @id @default(cuid())
  orgId               String
  employeeId          String
  employee            Employee @relation(fields: [employeeId], references: [id])
  periodMonth         Int
  periodYear          Int
  earnings            Json
  deductions          Json
  netPay              Float
  generatedAt         DateTime @default(now())
  // 010 FR-005: itemized statutory lines [{groupId, componentId, name, amount}], kept apart
  // from non-statutory `deductions`; netPay already subtracts them.
  statutoryDeductions Json?

  // 026-global-multi-currency-payroll — the currency netPay/earnings/deductions are expressed
  // in; immutable once generated even if the employee's currency assignment later changes
  currency String?
  // 026 FR-007: the payroll country the payslip was computed under (null = single-country org)
  country  String?

  @@unique([employeeId, periodMonth, periodYear])
}

model JobPosting {
  id           String           @id @default(cuid())
  orgId        String
  title        String
  departmentId String
  department   Department       @relation(fields: [departmentId], references: [id])
  status       JobPostingStatus @default(OPEN)
  openings     Int
  applications Application[]
  // 020 FR-001: public-facing description on the careers page
  description  String?

  @@index([orgId, status])
}

model Candidate {
  id           String        @id @default(cuid())
  orgId        String
  name         String
  email        String
  phone        String?
  resumeUrl    String
  createdAt    DateTime      @default(now())
  applications Application[]

  // 008-document-esignature
  documents                 Document[]
  signatureRequestsReceived SignatureRequest[]

  @@index([orgId])
}

model Application {
  id              String           @id @default(cuid())
  orgId           String
  candidateId     String
  candidate       Candidate        @relation(fields: [candidateId], references: [id])
  jobPostingId    String
  jobPosting      JobPosting       @relation(fields: [jobPostingId], references: [id])
  stage           ApplicationStage @default(APPLIED)
  interviewRounds InterviewRound[]
  createdAt       DateTime         @default(now())

  // 020-public-careers-portal, 021-referral-program — where this application came from
  source               ApplicationSource @default(INTERNAL)
  // 020 FR-008: hash of the reference code a public applicant uses to check status
  publicReferenceHash  String?           @unique
  referredByEmployeeId String?
  referredBy           Employee?         @relation(fields: [referredByEmployeeId], references: [id])

  // 021-referral-program, 022-background-verification
  referral        Referral?
  backgroundCheck BackgroundCheck?
  hireOverrides   HireOverride[]

  @@unique([candidateId, jobPostingId])
  @@index([orgId, stage])
}

model InterviewRound {
  id            String          @id @default(cuid())
  orgId         String
  applicationId String
  application   Application     @relation(fields: [applicationId], references: [id])
  interviewerId String
  interviewer   Employee        @relation(fields: [interviewerId], references: [id])
  scheduledAt   DateTime
  result        InterviewResult @default(PENDING)
  feedback      String?
  recordedAt    DateTime?

  @@index([applicationId])
}

// Append-only audit trail — Principle IV (Auditability & Data Integrity)
model ActivityLog {
  id        String   @id @default(cuid())
  orgId     String
  actorId   String
  actor     Employee @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([orgId, entity, entityId])
}

// ============================================================================
// 006-notifications
// ============================================================================

model Notification {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([orgId, userId, read])
}

// ============================================================================
// 007-employee-onboarding
// ============================================================================

enum OnboardingOwnerRole {
  HR
  MANAGER
  IT
  EMPLOYEE
}

enum TaskCompletionStatus {
  INCOMPLETE
  COMPLETE
}

// TODO(007): the spec requires a "standard, configurable set of default tasks" (FR-001, FR-010)
// but does not enumerate them — seed content is a planning-time decision, not specified here.
model OnboardingTaskTemplate {
  id          String              @id @default(cuid())
  orgId       String
  description String
  ownerRole   OnboardingOwnerRole @default(HR)
  order       Int
  // 014: marks a task other features complete automatically (e.g. ASSET_ASSIGNMENT)
  systemKey   String?

  @@index([orgId, order])
}

model OnboardingChecklist {
  id         String           @id @default(cuid())
  orgId      String
  employeeId String           @unique
  employee   Employee         @relation(fields: [employeeId], references: [id])
  createdAt  DateTime         @default(now())
  tasks      OnboardingTask[]

  @@index([orgId])
}

model OnboardingTask {
  id              String               @id @default(cuid())
  orgId           String
  checklistId     String
  checklist       OnboardingChecklist  @relation(fields: [checklistId], references: [id])
  description     String
  ownerRole       OnboardingOwnerRole  @default(HR)
  status          TaskCompletionStatus @default(INCOMPLETE)
  completedById   String?
  completedBy     Employee?            @relation(fields: [completedById], references: [id])
  completedAt     DateTime?
  // FR-006: a specific person this task is reassigned to (overrides ownerRole routing).
  ownerEmployeeId String?
  position        Int                  @default(0)
  createdAt       DateTime             @default(now())
  systemKey       String?

  @@index([checklistId, status])
  @@index([orgId, ownerEmployeeId])
}

// ============================================================================
// 008-document-esignature
// ============================================================================

enum DocumentOwnerType {
  EMPLOYEE
  CANDIDATE
  // 008: company-wide files (e.g. a published policy) owned by no single person
  ORGANIZATION
}

enum SignatureStatus {
  AWAITING
  SIGNED
}

model Document {
  id             String            @id @default(cuid())
  orgId          String
  ownerType      DocumentOwnerType
  employeeId     String?
  employee       Employee?         @relation(fields: [employeeId], references: [id])
  candidateId    String?
  candidate      Candidate?        @relation(fields: [candidateId], references: [id])
  label          String
  fileUrl        String
  version        Int               @default(1)
  isCurrent      Boolean           @default(true)
  uploadedAt     DateTime          @default(now())
  // 008: fileUrl holds the storage key (lib/storage.ts); these describe the stored file.
  contentType    String?
  sizeBytes      Int?
  originalName   String?
  uploadedById   String?
  // FR-003: personal documents are owner + HR/Admin only unless explicitly manager-visible.
  managerVisible Boolean           @default(false)

  signatureRequests      SignatureRequest[]
  courseAssignmentProofs CourseAssignment[]
  policies               Policy[]

  @@index([orgId, employeeId, label])
  @@index([orgId, candidateId, label])
}

model SignatureRequest {
  id                   String            @id @default(cuid())
  orgId                String
  documentId           String
  document             Document          @relation(fields: [documentId], references: [id])
  recipientType        DocumentOwnerType
  recipientEmployeeId  String?
  recipientEmployee    Employee?         @relation(fields: [recipientEmployeeId], references: [id])
  recipientCandidateId String?
  recipientCandidate   Candidate?        @relation(fields: [recipientCandidateId], references: [id])
  status               SignatureStatus   @default(AWAITING)
  signedAt             DateTime?
  signedByName         String?
  createdAt            DateTime          @default(now())
  // 008: who sent it, the signing user (employees), the offer's application (US2.4), and the
  // hashed single-use link token candidates sign through (they have no login).
  sentById             String?
  signedByUserId       String?
  applicationId        String?
  accessTokenHash      String?           @unique

  @@index([orgId, status])
}

model Policy {
  id          String    @id @default(cuid())
  orgId       String
  title       String
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id])
  publishedAt DateTime  @default(now())

  acknowledgments PolicyAcknowledgment[]

  @@index([orgId])
}

model PolicyAcknowledgment {
  id             String   @id @default(cuid())
  orgId          String
  policyId       String
  policy         Policy   @relation(fields: [policyId], references: [id])
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  acknowledgedAt DateTime @default(now())

  @@unique([policyId, employeeId])
}

// ============================================================================
// 009-resignation-exit
// ============================================================================

enum ResignationStatus {
  PENDING
  SERVING_NOTICE
  WITHDRAWN
  COMPLETED
}

enum ExitTaskOwnerRole {
  IT
  FINANCE
  HR
}

model Resignation {
  id                 String            @id @default(cuid())
  orgId              String
  employeeId         String
  employee           Employee          @relation(fields: [employeeId], references: [id])
  proposedLastDay    DateTime          @db.Date
  confirmedLastDay   DateTime?         @db.Date
  status             ResignationStatus @default(PENDING)
  exitInterviewNotes String?
  createdAt          DateTime          @default(now())
  // 009: lifecycle attribution and timestamps
  reason             String?
  acknowledgedById   String?
  acknowledgedAt     DateTime?
  withdrawnAt        DateTime?
  completedAt        DateTime?
  forcedOffboard     Boolean           @default(false)
  exitDuePromptedAt  DateTime?

  exitChecklist ExitChecklist?

  @@index([orgId, employeeId, status])
}

model ExitChecklist {
  id                String      @id @default(cuid())
  orgId             String
  resignationId     String      @unique
  resignation       Resignation @relation(fields: [resignationId], references: [id])
  createdAt         DateTime    @default(now())
  tasks             ExitTask[]
  // FR-009: active direct reports of a resigning manager, captured at creation
  reportsToReassign Json?
  // FR-008: set when a withdrawal closes the checklist
  closedAt          DateTime?

  @@index([orgId])
}

model ExitTask {
  id            String               @id @default(cuid())
  orgId         String
  checklistId   String
  checklist     ExitChecklist        @relation(fields: [checklistId], references: [id])
  ownerRole     ExitTaskOwnerRole
  description   String
  status        TaskCompletionStatus @default(INCOMPLETE)
  completedById String?
  completedBy   Employee?            @relation(fields: [completedById], references: [id])
  completedAt   DateTime?
  // 014: e.g. ASSET_RETURN — completed automatically and guarded by the assets module
  systemKey     String?

  @@index([checklistId, status])
}

// ============================================================================
// 010-statutory-payroll-tax
// ============================================================================

enum StatutoryRuleType {
  FLAT
  PERCENTAGE
  BRACKET
}

// TODO(010): ruleConfig's JSON shape (e.g., { "percent": 12 } vs a bracket array of
// { "upTo": number, "rate": number } tuples) is intentionally left to /speckit-plan —
// the spec only requires the three rule *types*, not a wire format.
model StatutoryComponent {
  id            String            @id @default(cuid())
  orgId         String
  name          String
  ruleType      StatutoryRuleType
  ruleConfig    Json
  // 026-global-multi-currency-payroll — null = applies regardless of employee country
  country       String?
  effectiveFrom DateTime          @db.Date
  // 010: rows are effective-dated versions of one component sharing groupId (FR-002);
  // active=false discontinues the component from effectiveFrom.
  groupId       String
  active        Boolean           @default(true)
  createdById   String?
  createdAt     DateTime          @default(now())

  exemptions StatutoryExemption[]

  @@index([orgId, country])
  @@index([orgId, groupId, effectiveFrom])
}

model StatutoryExemption {
  id                   String             @id @default(cuid())
  orgId                String
  employeeId           String
  employee             Employee           @relation(fields: [employeeId], references: [id])
  statutoryComponentId String
  statutoryComponent   StatutoryComponent @relation(fields: [statutoryComponentId], references: [id])
  // 010: exemptions apply to the component across all its versions
  groupId              String
  reason               String?
  createdAt            DateTime           @default(now())

  @@unique([employeeId, statutoryComponentId])
  @@unique([employeeId, groupId])
}

// The exported artifact from "generate a compliance report" (FR-006/FR-007) — totals are a
// snapshot at generation time, not recomputed live, so a re-run's new report is a new row.
model ComplianceReport {
  id            String   @id @default(cuid())
  orgId         String
  periodMonth   Int
  periodYear    Int
  totals        Json
  fileUrl       String?
  generatedAt   DateTime @default(now())
  generatedById String?

  @@index([orgId, periodYear, periodMonth])
}

// ============================================================================
// 011-hr-analytics-reporting
// ============================================================================
// No new models — pure aggregation over Employee, Attendance, LeaveRequest, and Payslip.
// See docs/feature.md § 011 for the read-only queries this feature computes.

// ============================================================================
// 012-performance-management
// ============================================================================

enum GoalStatus {
  PENDING_APPROVAL
  ACTIVE
  CHANGES_REQUESTED
  COMPLETED
}

enum ReviewScopeType {
  COMPANY
  DEPARTMENT
}

enum ReviewStatus {
  IN_PROGRESS
  FINAL
}

model Goal {
  id                String     @id @default(cuid())
  orgId             String
  employeeId        String
  employee          Employee   @relation(fields: [employeeId], references: [id])
  description       String
  targetDate        DateTime   @db.Date
  status            GoalStatus @default(PENDING_APPROVAL)
  progress          String?
  createdAt         DateTime   @default(now())
  // 012: progress %, the manager's change request, and approval attribution
  progressPercent   Int?
  changeRequestNote String?
  approvedById      String?
  approvedAt        DateTime?
  updatedAt         DateTime   @default(now()) @updatedAt

  @@index([orgId, employeeId, status])
}

model ReviewCycle {
  id           String          @id @default(cuid())
  orgId        String
  name         String
  startDate    DateTime        @db.Date
  endDate      DateTime        @db.Date
  scopeType    ReviewScopeType @default(COMPANY)
  departmentId String?
  department   Department?     @relation(fields: [departmentId], references: [id])
  createdById  String?
  createdAt    DateTime        @default(now())

  reviews Review[]

  @@index([orgId, endDate])
}

model Review {
  id                String       @id @default(cuid())
  orgId             String
  employeeId        String
  employee          Employee     @relation("ReviewEmployee", fields: [employeeId], references: [id])
  reviewCycleId     String
  reviewCycle       ReviewCycle  @relation(fields: [reviewCycleId], references: [id])
  managerId         String
  manager           Employee     @relation("ReviewManager", fields: [managerId], references: [id])
  rating            String?
  managerComments   String?
  employeeComments  String?
  status            ReviewStatus @default(IN_PROGRESS)
  finalizedAt       DateTime?
  // 012 FR-011: reviewer follows the reporting line until final; FR-007 HR corrections
  previousManagerId String?
  managerChangedAt  DateTime?
  correctedAt       DateTime?
  createdAt         DateTime     @default(now())

  @@unique([employeeId, reviewCycleId])
  @@index([orgId, reviewCycleId, status])
}

// ============================================================================
// 013-sso-mfa
// ============================================================================

enum SsoProvider {
  GOOGLE
  MICROSOFT
}

model IdentityProviderConfig {
  id          String       @id @default(cuid())
  orgId       String       @unique
  // null = no SSO provider configured (settings row may exist just for mfaRequired)
  provider    SsoProvider?
  enforced    Boolean      @default(false)
  // 013 FR-009: every password account must have MFA
  mfaRequired Boolean      @default(false)
  updatedById String?
  updatedAt   DateTime     @default(now()) @updatedAt
}

model SsoIdentityLink {
  id         String      @id @default(cuid())
  orgId      String
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  provider   SsoProvider
  externalId String
  // the verified email at link time (edge case: a later mismatch fails clearly)
  email      String?
  createdAt  DateTime    @default(now())

  @@unique([provider, externalId])
  @@index([orgId, userId])
}

model MfaEnrollment {
  id             String    @id @default(cuid())
  orgId          String
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  // AES-256-GCM encrypted base32 TOTP secrets (lib/secretBox.ts); pendingSecret until confirmed
  secret         String?
  pendingSecret  String?
  confirmedAt    DateTime?
  enrolledAt     DateTime  @default(now())
  // FR-011: consecutive failed codes -> temporary lock; lastUsedStep blocks code replay
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastUsedStep   Int?
}

// ============================================================================
// 014-asset-expense-management
// ============================================================================

enum AssetStatus {
  UNASSIGNED
  ASSIGNED
  LOST
  DAMAGED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model Asset {
  id          String      @id @default(cuid())
  orgId       String
  description String
  identifier  String
  status      AssetStatus @default(UNASSIGNED)
  createdAt   DateTime    @default(now())

  assignments AssetAssignment[]

  @@unique([orgId, identifier])
  @@index([orgId, status])
}

model AssetAssignment {
  id           String    @id @default(cuid())
  orgId        String
  assetId      String
  asset        Asset     @relation(fields: [assetId], references: [id])
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  assignedAt   DateTime  @default(now())
  returnedAt   DateTime?
  // 014: who assigned/closed it, and how it ended (RETURNED | LOST | DAMAGED)
  assignedById String?
  closedById   String?
  outcome      String?

  @@index([assetId])
  @@index([employeeId])
}

model ExpenseClaim {
  id                 String        @id @default(cuid())
  orgId              String
  employeeId         String
  employee           Employee      @relation("ExpenseClaimant", fields: [employeeId], references: [id])
  amount             Float
  category           String
  receiptUrl         String?
  status             ExpenseStatus @default(PENDING)
  approverId         String?
  approver           Employee?     @relation("ExpenseApprover", fields: [approverId], references: [id])
  rejectionReason    String?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  // 014: receipt metadata (receiptUrl holds the storage key), description, decision trail
  description        String?
  receiptName        String?
  receiptContentType String?
  decidedAt          DateTime?
  paidById           String?

  @@index([orgId, status])
}

// 014 FR-008: HR-configurable expense categories; requiresReceipt blocks submission without one.
model ExpenseCategory {
  id              String   @id @default(cuid())
  orgId           String
  name            String
  requiresReceipt Boolean  @default(true)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([orgId, name])
}

// ============================================================================
// 015-multi-tenant-activation
// ============================================================================

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

// A lookup/directory table for orgId values, not a Prisma-relational parent of every other
// model (see header note) — so activating this doesn't require touching 001-014's schema.
model Organization {
  id            String             @id @default(cuid())
  name          String
  status        OrganizationStatus @default(ACTIVE)
  createdAt     DateTime           @default(now())
  // 015: human-friendly unique handle used at sign-in when an email exists in several orgs
  slug          String             @unique
  suspendedAt   DateTime?
  // 016 FR-008: the intended top of the company (not flagged as an orphan on the org chart)
  topEmployeeId String?
}

// System-level operator, deliberately NOT an Employee/User of any organization (FR-005).
model SuperAdmin {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  createdAt           DateTime  @default(now())
  // 015: same lockout model as org users (001 FR-011)
  failedLoginAttempts Int       @default(0)
  lockedAt            DateTime?
}

// ============================================================================
// 016-org-chart-visualization
// ============================================================================
// No new models — a read-only visualization over Employee's existing reporting-line data.
// "Structural gap" (orphan/headless) flags are computed at query time, not stored.

// ============================================================================
// 017-hr-helpdesk-ticketing
// ============================================================================

enum TicketStatus {
  OPEN
  ASSIGNED
  RESOLVED
  REOPENED
}

model TicketCategory {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]

  @@unique([orgId, name])
}

model Ticket {
  id              String         @id @default(cuid())
  orgId           String
  employeeId      String
  employee        Employee       @relation("TicketRequester", fields: [employeeId], references: [id])
  categoryId      String
  category        TicketCategory @relation(fields: [categoryId], references: [id])
  description     String
  status          TicketStatus   @default(OPEN)
  assigneeId      String?
  assignee        Employee?      @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdAt       DateTime       @default(now())
  // 017: short subject, resolution time (FR-010), and the overdue clock (FR-009) — set on
  // create/reopen/requester reply, cleared by an HR reply or resolution.
  subject         String?
  resolvedAt      DateTime?
  awaitingHrSince DateTime?
  updatedAt       DateTime       @default(now()) @updatedAt

  replies TicketReply[]

  @@index([orgId, status])
}

model TicketReply {
  id        String   @id @default(cuid())
  orgId     String
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  authorId  String
  author    Employee @relation(fields: [authorId], references: [id])
  message   String
  createdAt DateTime @default(now())
  fromHr    Boolean  @default(false)

  @@index([ticketId])
}

// 017 FR-009: per-organization helpdesk configuration.
model HelpdeskSettings {
  id           String   @id @default(cuid())
  orgId        String   @unique
  overdueHours Int      @default(48)
  updatedAt    DateTime @default(now()) @updatedAt
}

// ============================================================================
// 018-employee-engagement-surveys
// ============================================================================
//
// ANONYMITY GUARANTEE (load-bearing, see checklists/018): SurveyParticipation exists ONLY to
// gate duplicate submissions and compute response-rate denominators. It is NEVER joined to
// SurveyResponse/SurveyAnswer in application code — SurveyResponse carries no employeeId at
// all, by design. Do not add one during implementation.

enum SurveyStatus {
  OPEN
  CLOSED
}

enum SurveyAudienceType {
  COMPANY
  DEPARTMENT
}

enum SurveyQuestionType {
  ENPS
  TEXT
}

model Survey {
  id                  String             @id @default(cuid())
  orgId               String
  title               String
  status              SurveyStatus       @default(OPEN)
  audienceType        SurveyAudienceType
  departmentId        String?
  department          Department?        @relation(fields: [departmentId], references: [id])
  sentAt              DateTime?
  // 018: audience snapshot at send (FR-010), anonymity threshold (FR-005), lifecycle
  audienceEmployeeIds Json?
  audienceSize        Int                @default(0)
  minResponses        Int                @default(5)
  createdById         String?
  closedAt            DateTime?

  questions     SurveyQuestion[]
  participation SurveyParticipation[]
  responses     SurveyResponse[]

  @@index([orgId, status])
}

model SurveyQuestion {
  id       String             @id @default(cuid())
  orgId    String
  surveyId String
  survey   Survey             @relation(fields: [surveyId], references: [id])
  type     SurveyQuestionType
  prompt   String
  order    Int

  answers SurveyAnswer[]

  @@index([surveyId, order])
}

// Duplicate-prevention + response-rate denominator ONLY — see anonymity note above.
model SurveyParticipation {
  id          String   @id @default(cuid())
  orgId       String
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id])
  employeeId  String
  respondedAt DateTime @default(now())

  @@unique([surveyId, employeeId])
}

// Deliberately carries no employeeId / userId — see anonymity note above.
model SurveyResponse {
  id          String   @id @default(cuid())
  orgId       String
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id])
  submittedAt DateTime @default(now())

  answers SurveyAnswer[]

  @@index([surveyId])
}

model SurveyAnswer {
  id         String         @id @default(cuid())
  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id])
  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id])
  scoreValue Int?
  textValue  String?

  @@index([responseId])
}

// ============================================================================
// 019-mobile-pwa
// ============================================================================

model DeviceRegistration {
  id           String   @id @default(cuid())
  orgId        String
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  pushToken    String
  platform     String
  registeredAt DateTime @default(now())
  // 019: the push endpoint (unique per browser subscription) and freshness
  endpoint     String?  @unique
  deviceId     String?
  lastSeenAt   DateTime @default(now())

  @@index([orgId, userId])
}

// ============================================================================
// 020-public-careers-portal
// ============================================================================
// No new models — reuses JobPosting/Candidate/Application (see Application.source below,
// shared with 021-referral-program).

enum ApplicationSource {
  INTERNAL
  PUBLIC
  REFERRAL
}

// ============================================================================
// 021-referral-program
// ============================================================================

enum ReferralStatus {
  // 021: in the pipeline, not yet hired or rejected
  IN_PIPELINE
  PENDING
  PAYABLE
  PAID
  FORFEITED
  CLOSED_NO_BONUS
}

model ReferralProgramConfig {
  id             String   @id @default(cuid())
  orgId          String   @unique
  bonusAmount    Float
  qualifyingDays Int
  effectiveFrom  DateTime @default(now())
}

model Referral {
  id                 String         @id @default(cuid())
  orgId              String
  referrerEmployeeId String
  referrerEmployee   Employee       @relation(fields: [referrerEmployeeId], references: [id])
  applicationId      String         @unique
  application        Application    @relation(fields: [applicationId], references: [id])
  bonusAmount        Float
  qualifyingDays     Int
  status             ReferralStatus @default(IN_PIPELINE)
  hiredAt            DateTime?
  qualifyingUntil    DateTime?
  paidAt             DateTime?
  // 021: the hire as an employee (matched by email or linked by HR), payroll scheduling, audit
  hireEmployeeId     String?
  payrollPeriodMonth Int?
  payrollPeriodYear  Int?
  closedReason       String?
  createdAt          DateTime       @default(now())

  @@index([orgId, status])
}

// ============================================================================
// 022-background-verification
// ============================================================================

enum BackgroundCheckStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
}

enum BackgroundCheckOutcome {
  CLEARED
  FLAGGED
}

enum BackgroundCheckItemResult {
  CLEARED
  FLAGGED
  UNABLE_TO_VERIFY
}

model BackgroundCheck {
  id             String                  @id @default(cuid())
  orgId          String
  applicationId  String                  @unique
  application    Application             @relation(fields: [applicationId], references: [id])
  status         BackgroundCheckStatus   @default(PENDING)
  overallOutcome BackgroundCheckOutcome?
  initiatedById  String?
  createdAt      DateTime                @default(now())
  completedAt    DateTime?

  items BackgroundCheckItem[]

  @@index([orgId, status])
}

model BackgroundCheckItem {
  id                String                     @id @default(cuid())
  orgId             String
  backgroundCheckId String
  backgroundCheck   BackgroundCheck            @relation(fields: [backgroundCheckId], references: [id])
  label             String
  result            BackgroundCheckItemResult?
  notes             String?
  recordedById      String?
  recordedAt        DateTime?
  createdAt         DateTime                   @default(now())

  @@index([backgroundCheckId])
}

model HireOverride {
  id             String      @id @default(cuid())
  orgId          String
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id])
  justification  String
  // 022: INCOMPLETE_CHECK (FR-005) or FLAGGED_CHECK (FR-006)
  kind           String      @default("FLAGGED_CHECK")
  overriddenById String
  overriddenBy   Employee    @relation(fields: [overriddenById], references: [id])
  createdAt      DateTime    @default(now())

  @@index([applicationId])
}

// ============================================================================
// 023-learning-development
// ============================================================================

enum CourseAssignmentStatus {
  INCOMPLETE
  COMPLETE
  OVERDUE
}

model Course {
  id                   String   @id @default(cuid())
  orgId                String
  title                String
  description          String?
  contentUrl           String?
  requiresProof        Boolean  @default(false)
  isComplianceRequired Boolean  @default(false)
  archived             Boolean  @default(false)
  createdById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  assignments CourseAssignment[]
  rules       CourseAssignmentRule[]

  @@index([orgId, isComplianceRequired])
}

model CourseAssignment {
  id              String                 @id @default(cuid())
  orgId           String
  courseId        String
  course          Course                 @relation(fields: [courseId], references: [id])
  employeeId      String
  employee        Employee               @relation(fields: [employeeId], references: [id])
  dueDate         DateTime?              @db.Date
  status          CourseAssignmentStatus @default(INCOMPLETE)
  completedAt     DateTime?
  proofDocumentId String?
  proofDocument   Document?              @relation(fields: [proofDocumentId], references: [id])
  // 023: the group assignment this came from (null for a direct one), who assigned it and when.
  ruleId          String?
  rule            CourseAssignmentRule?  @relation(fields: [ruleId], references: [id])
  assignedById    String?
  assignedAt      DateTime               @default(now())

  @@index([orgId, courseId, status])
  @@index([employeeId, status])
}

enum CourseAudience {
  COMPANY
  DEPARTMENT
  EMPLOYEES
}

// 023 FR-002/FR-007: a group assignment. Compliance courses keep enrolling new hires who match.
model CourseAssignmentRule {
  id           String         @id @default(cuid())
  orgId        String
  courseId     String
  course       Course         @relation(fields: [courseId], references: [id])
  audience     CourseAudience
  departmentId String?
  dueDate      DateTime?      @db.Date
  createdById  String?
  createdAt    DateTime       @default(now())

  assignments CourseAssignment[]

  @@index([orgId, courseId])
}

// ============================================================================
// 024-succession-planning
// ============================================================================

enum ReadinessLevel {
  READY_NOW
  READY_1_2_YEARS
  DEVELOPING
}

model SuccessionPlan {
  id                 String    @id @default(cuid())
  orgId              String
  positionEmployeeId String    @unique
  positionEmployee   Employee  @relation(fields: [positionEmployeeId], references: [id])
  createdAt          DateTime  @default(now())
  // FR-001: unmarking keeps the plan and its history (FR-006); re-marking reuses it.
  isCritical         Boolean   @default(true)
  markedById         String?
  markedAt           DateTime  @default(now())
  unmarkedAt         DateTime?

  candidates SuccessionCandidate[]

  @@index([orgId])
}

model SuccessionCandidate {
  id                  String         @id @default(cuid())
  orgId               String
  successionPlanId    String
  successionPlan      SuccessionPlan @relation(fields: [successionPlanId], references: [id])
  candidateEmployeeId String
  candidateEmployee   Employee       @relation(fields: [candidateEmployeeId], references: [id])
  readinessLevel      ReadinessLevel
  isValid             Boolean        @default(true)
  updatedAt           DateTime       @updatedAt
  createdAt           DateTime       @default(now())
  addedById           String?
  // FR-005: why and when the entry stopped being viable (offboarded, or removed by HR).
  invalidReason       String?
  invalidatedAt       DateTime?

  readinessChanges SuccessionReadinessChange[]

  @@unique([successionPlanId, candidateEmployeeId])
  @@index([successionPlanId])
  @@index([candidateEmployeeId])
}

// FR-004: every readiness level a successor has had, with who set it and when.
model SuccessionReadinessChange {
  id          String              @id @default(cuid())
  orgId       String
  candidateId String
  candidate   SuccessionCandidate @relation(fields: [candidateId], references: [id])
  fromLevel   ReadinessLevel?
  toLevel     ReadinessLevel
  note        String?
  changedById String?
  changedAt   DateTime            @default(now())

  @@index([candidateId])
}

// ============================================================================
// 025-white-labeling
// ============================================================================

model OrganizationBranding {
  id              String    @id @default(cuid())
  orgId           String    @unique
  // Internal storage key for the logo (never returned; served via /api/public/branding/:slug/logo).
  logoUrl         String?
  logoContentType String?
  logoUpdatedAt   DateTime?
  primaryColor    String?
  updatedById     String?
  updatedAt       DateTime  @default(now()) @updatedAt
}

// ============================================================================
// 026-global-multi-currency-payroll
// ============================================================================
// Employee.payrollCountry/payrollCurrency, SalaryStructure.currency, Payslip.currency, and
// StatutoryComponent.country are declared alongside their v0.1/v1.1 models above.

// FR-001/US1.3: which country's rules and which currency apply to an employee from a date on.
model PayrollAssignment {
  id            String   @id @default(cuid())
  orgId         String
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  country       String
  currency      String
  effectiveFrom DateTime @db.Date
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([orgId, employeeId, effectiveFrom])
}

// FR-008: 1 fromCurrency = rate toCurrency for one period; re-recording replaces it.
model ExchangeRate {
  id           String   @id @default(cuid())
  orgId        String
  fromCurrency String
  toCurrency   String
  rate         Float
  periodMonth  Int
  periodYear   Int
  recordedById String?
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([orgId, fromCurrency, toCurrency, periodMonth, periodYear])
}

// Per-organization defaults. Everything optional: a single-country org needs none (FR-011).
model PayrollCurrencySettings {
  id                String   @id @default(cuid())
  orgId             String   @unique
  // The org's home country/currency: employees without an assignment fall back to these, and
  // statutory components with no country belong to the home country.
  defaultCountry    String?
  defaultCurrency   String?
  reportingCurrency String?
  updatedAt         DateTime @default(now()) @updatedAt
}

// ============================================================================
// 027-hr-assistant-chatbot
// ============================================================================
//
// TODO(027): the spec requires the HR-facing topic overview to have "no individual employee's
// identity attributable to a specific question" (FR-007). Rather than guess a retention/
// redaction policy for it, this model deliberately stores only a derived topic label — not the
// raw question/answer text, and not an employeeId — mirroring the 018 anonymity pattern. If
// implementation needs the raw Q&A for debugging, that MUST go in a separate, access-restricted
// log with its own retention policy, decided during /speckit-plan, not this table.
model AssistantInteraction {
  id            String   @id @default(cuid())
  orgId         String
  topic         String
  wasAnswered   Boolean
  groundingType String?
  createdAt     DateTime @default(now())

  @@index([orgId, createdAt])
}

// 027 FR-004: HR-authored policy answers the assistant may quote, optionally pointing at the
// published 008 policy document they summarise. Read fresh on every question (FR-009).
model AssistantKnowledgeArticle {
  id          String   @id @default(cuid())
  orgId       String
  title       String
  body        String
  keywords    Json
  policyId    String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([orgId])
}

// 019 FR-005: replay-safe retries — the first response to an Idempotency-Key is stored and
// returned again for any retry with the same key from the same caller.
model IdempotencyRecord {
  id          String    @id @default(cuid())
  scopeHash   String    @unique // hash of caller credential + method + path + key
  status      Int?
  body        Json?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

// 022: the org-wide default check items offered when a check is initiated.
model BackgroundCheckSettings {
  id           String   @id @default(cuid())
  orgId        String   @unique
  defaultItems Json
  updatedAt    DateTime @default(now()) @updatedAt
}

// 028-time-tracker — projects, tasks, time entries, one running timer per employee and weekly
// timesheets. Employee ids are plain columns: this module reads people only through 002's service.
enum TimeProjectStatus {
  ACTIVE
  ARCHIVED
}

enum TimeEntrySource {
  MANUAL
  TIMER
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model TimeProject {
  id         String            @id @default(cuid())
  orgId      String
  name       String
  code       String
  clientName String?
  billable   Boolean           @default(false)
  status     TimeProjectStatus @default(ACTIVE)
  ownerId    String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  tasks   TimeTask[]
  members TimeProjectMember[]
  entries TimeEntry[]

  @@unique([orgId, code])
  @@index([orgId, status])
}

model TimeProjectMember {
  projectId  String
  project    TimeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  orgId      String
  addedAt    DateTime    @default(now())

  @@id([projectId, employeeId])
  @@index([orgId, employeeId])
}

model TimeTask {
  id        String            @id @default(cuid())
  orgId     String
  projectId String
  project   TimeProject       @relation(fields: [projectId], references: [id])
  name      String
  status    TimeProjectStatus @default(ACTIVE)
  createdAt DateTime          @default(now())

  entries TimeEntry[]
  timers  RunningTimer[]

  @@unique([projectId, name])
}

model TimeEntry {
  id         String          @id @default(cuid())
  orgId      String
  employeeId String
  projectId  String
  project    TimeProject     @relation(fields: [projectId], references: [id])
  taskId     String
  task       TimeTask        @relation(fields: [taskId], references: [id])
  date       DateTime        @db.Date
  weekStart  DateTime        @db.Date
  minutes    Int
  note       String?
  billable   Boolean
  source     TimeEntrySource @default(MANUAL)
  flagged    Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([orgId, employeeId, weekStart])
  @@index([orgId, date])
  @@index([orgId, projectId, date])
}

model RunningTimer {
  id         String   @id @default(cuid())
  orgId      String
  employeeId String   @unique
  taskId     String
  task       TimeTask @relation(fields: [taskId], references: [id])
  projectId  String
  startedAt  DateTime
  note       String?
}

model Timesheet {
  id          String          @id @default(cuid())
  orgId       String
  employeeId  String
  weekStart   DateTime        @db.Date
  status      TimesheetStatus @default(DRAFT)
  submittedAt DateTime?
  decidedAt   DateTime?
  decidedById String?
  reason      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([employeeId, weekStart])
  @@index([orgId, weekStart, status])
}

// 029-activity-presence — reported activity state as merged stretches, latest presence per
// employee, per-org settings. Employee ids are plain columns (people come from 002's service).
enum ActivityState {
  ACTIVE
  IDLE
  LOCKED
}

model ActivitySpan {
  id         String        @id @default(cuid())
  orgId      String
  employeeId String
  state      ActivityState
  startedAt  DateTime
  endedAt    DateTime

  @@index([orgId, employeeId, startedAt])
  @@index([endedAt])
}

model ActivityPresence {
  employeeId String        @id
  orgId      String
  state      ActivityState
  lastSeenAt DateTime
  spanId     String?

  @@index([orgId])
}

model ActivitySettings {
  orgId                String   @id
  enabled              Boolean  @default(true)
  idleThresholdMinutes Int      @default(5)
  updatedAt            DateTime @updatedAt
}

// 030-ai-assistant — one private chat per row: the model-visible history (replayed unchanged,
// thinking blocks included), the messages shown to the user, and at most one pending action
// awaiting the owner's confirmation. Deleted after 90 days without activity.
model AssistantConversation {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  employeeId String?
  title      String
  history    Json
  display    Json
  pending    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orgId, userId, updatedAt])
  @@index([updatedAt])
}
